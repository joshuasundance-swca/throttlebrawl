{
  "type": "hud-layout",
  "id": "classic",
  "name": "Classic",
  "appliesTo": ["touch", "desktop"],
  "elements": [
    {
      "element": "speedometer",
      "visible": true,
      "anchor": "bottom-left",
      "offset": [0.03, 0.04],
      "scale": 1.0,
      "opacity": 1.0
    },
    {
      "element": "position",
      "visible": true,
      "anchor": "top-left",
      "offset": [0.03, 0.03],
      "scale": 1.0,
      "opacity": 1.0
    },
    {
      "element": "touch-attack",
      "visible": true,
