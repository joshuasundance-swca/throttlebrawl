    },
    {
      "element": "touch-brake",
      "visible": true,
      "anchor": "bottom-right",
      "offset": [0.4, 0.06],
      "scale": 0.9,
      "opacity": 0.7,
      "touchOnly": true
    },
    {
      "element": "touch-stick-zone",
      "visible": true,
