{
  "type": "bark-set",
  "id": "pruitt-core",
  "name": "Sgt. Pruitt: core lines",
  "tags": ["cop", "m4"],
  "defaults": {
    "speaker": "sgt-pruitt",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "pruitt-siren-teeth",
      "trigger": "cop-siren",
      "text": "License, registration, and your front teeth.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-teeth",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-years",
      "trigger": "cop-siren",
      "text": "Twenty-two years of this.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-years",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-pay",
      "trigger": "cop-siren",
      "text": "Pull over. Or don't. Same pay.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-pay",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-ground",
      "trigger": "busted",
      "text": "Right to remain on the ground.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-bust-ground",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-paperwork",
      "trigger": "busted",
      "text": "Stay down. Paperwork's long.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-bust-paperwork",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-hit-resisting",
      "trigger": "hit-landed",
      "text": "That's resisting. Probably.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-hit-resisting",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-hit-baton",
      "trigger": "hit-landed",
      "text": "Baton says hello.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-hit-baton",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-taken-tuesday",
      "trigger": "hit-taken",
      "text": "Assaulting an officer. On a Tuesday.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-taken-tuesday",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-taken-later",
      "trigger": "hit-taken",
      "text": "I'm writing that down. Later.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-taken-later",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-down-walk",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Fine. I'll walk it off.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-down-walk",
      "audioStatus": "live",
      "audioNote": "Redone 2026-10-02 (run W-S): the words were right, but the old take sounded least like Sgt. Pruitt's other lines (speaker check). Now Kokoro-82M, run locally, in Sgt. Pruitt's reference voice (am_echo, speed 0.901, pitch -0.5). Veto it, or ask for the old take back from git history."
    },
    {
      "id": "pruitt-down-hassle",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "That's a felony and a hassle.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-down-hassle",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-crash-weather",
      "trigger": "crash-self",
      "text": "Write it up as weather.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-crash-weather",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-crash-county",
      "trigger": "crash-self",
      "text": "County bike. Not my problem.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-crash-county",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-backup",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "heat.level",
          "op": "gte",
          "value": 0.7
        }
      ],
      "text": "Backup's coming. Eventually.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-backup",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-overtime",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Overtime. You owe me overtime.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-overtime",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-again",
      "trigger": "busted",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Oh, it's you again. Good taser.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-bust-again",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-hurt",
      "trigger": "busted",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Stay down. I'm on my break.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-bust-hurt",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-hit-weak",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Lie still. It's less paperwork.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-hit-weak",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-taken-grudge",
      "trigger": "hit-taken",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "That's two counts now. Wonderful.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-taken-grudge",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-down-again",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Again. I'm too old for again.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-down-again",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-crash-late",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Close enough to the station. Done.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-crash-late",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-dawn",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "dawn"
        }
      ],
      "text": "Haven't had my coffee. Run.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-dawn",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-heat",
      "trigger": "busted",
      "when": [
        {
          "fact": "heat.level",
          "op": "gte",
          "value": 0.7
        }
      ],
      "text": "Whole county saw that. Down.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-bust-heat",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-siren-storm",
      "trigger": "cop-siren",
      "status": "live",
      "text": "Storm's coming. Still writing tickets.",
      "audioAsset": "audio/barks/pruitt-core/pruitt-siren-storm",
      "audioStatus": "live"
    },
    {
      "id": "pruitt-bust-shade",
      "trigger": "busted",
      "status": "live",
