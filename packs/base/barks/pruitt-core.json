{
  "type": "bark-set",
  "id": "pruitt-core",
  "name": "Sgt. Pruitt: core lines",
  "tags": ["cop", "m4"],
  "defaults": {
    "speaker": "sgt-pruitt",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "pruitt-siren-teeth",
      "trigger": "cop-siren",
      "text": "License, registration, and your front teeth."
    },
    {
      "id": "pruitt-siren-years",
      "trigger": "cop-siren",
      "text": "Twenty-two years of this."
    },
    {
      "id": "pruitt-siren-pay",
      "trigger": "cop-siren",
      "text": "Pull over. Or don't. Same pay."
    },
    {
      "id": "pruitt-bust-ground",
      "trigger": "busted",
      "text": "Right to remain on the ground."
    },
    {
      "id": "pruitt-bust-paperwork",
      "trigger": "busted",
      "text": "Stay down. Paperwork's long."
    },
    {
      "id": "pruitt-hit-resisting",
      "trigger": "hit-landed",
      "text": "That's resisting. Probably."
    },
    {
      "id": "pruitt-hit-baton",
      "trigger": "hit-landed",
      "text": "Baton says hello."
    },
    {
      "id": "pruitt-taken-tuesday",
      "trigger": "hit-taken",
      "text": "Assaulting an officer. On a Tuesday."
    },
    {
      "id": "pruitt-taken-later",
      "trigger": "hit-taken",
      "text": "I'm writing that down. Later."
    },
    {
      "id": "pruitt-down-walk",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Fine. I'll walk it off."
    },
    {
      "id": "pruitt-down-hassle",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "That's a felony and a hassle."
    },
    {
      "id": "pruitt-crash-weather",
      "trigger": "crash-self",
      "text": "Write it up as weather."
    },
    {
      "id": "pruitt-crash-county",
      "trigger": "crash-self",
      "text": "County bike. Not my problem."
    },
    {
      "id": "pruitt-siren-backup",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "heat.level",
          "op": "gte",
          "value": 0.7
        }
      ],
      "text": "Backup's coming. Eventually."
    },
    {
      "id": "pruitt-siren-overtime",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Overtime. You owe me overtime."
    },
    {
      "id": "pruitt-bust-again",
      "trigger": "busted",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Oh, it's you again. Good taser."
    },
    {
      "id": "pruitt-bust-hurt",
      "trigger": "busted",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Stay down. I'm on my break."
    },
    {
      "id": "pruitt-hit-weak",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Lie still. It's less paperwork."
    },
    {
      "id": "pruitt-taken-grudge",
      "trigger": "hit-taken",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "That's two counts now. Wonderful."
    },
    {
      "id": "pruitt-down-again",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Again. I'm too old for again."
    },
    {
      "id": "pruitt-crash-late",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Close enough to the station. Done."
    },
    {
      "id": "pruitt-siren-dawn",
      "trigger": "cop-siren",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "dawn"
        }
      ],
      "text": "Haven't had my coffee. Run."
    },
    {
      "id": "pruitt-bust-heat",
      "trigger": "busted",
      "when": [
        {
          "fact": "heat.level",
          "op": "gte",
          "value": 0.7
        }
      ],
      "text": "Whole county saw that. Down."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "pruitt-siren-teeth is the approved line from the tone guide, verbatim; every other line is an agent draft (M4 rivals-1, built early) that stays until vetoed. Conditioned lines cover leading, the last fifth of the race, a hurt speaker or target, the back of the field, time of day, memory (a grudge held this race, repeat takedowns) and the speaker's authored rivals.",
    "provenance": {
      "origin": "agent",
      "author": "agent",
      "createdAt": "2026-10-01"
    }
  }
}
