{
  "type": "bark-set",
  "id": "deacon-core",
  "name": "Deacon Vane: core lines",
  "tags": ["rival", "m1", "m2", "m4"],
  "defaults": {
    "speaker": "deacon-vane",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "deacon-start-ditch",
      "trigger": "race-start",
      "text": "Pray the ditch is soft, sinner.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-ditch",
      "audioStatus": "live"
    },
    {
      "id": "deacon-start-tithe",
      "trigger": "race-start",
      "text": "Tithe is ten percent. Of your bike.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-tithe",
      "audioStatus": "live"
    },
    {
      "id": "deacon-pass-behind",
      "trigger": "overtake",
      "text": "Get thee behind me. Stay there.",
      "audioAsset": "audio/barks/deacon-core/deacon-pass-behind",
      "audioStatus": "live"
    },
    {
      "id": "deacon-pass-meek",
      "trigger": "overtake",
      "text": "The meek inherit the earth. Not this road.",
      "audioAsset": "audio/barks/deacon-core/deacon-pass-meek",
      "audioStatus": "live"
    },
    {
      "id": "deacon-hit-baptized",
      "trigger": "hit-landed",
      "text": "Consider yourself baptized.",
      "audioAsset": "audio/barks/deacon-core/deacon-hit-baptized",
      "audioStatus": "live"
    },
    {
      "id": "deacon-hit-amen",
      "trigger": "hit-landed",
      "text": "Say amen. Say it from the ditch.",
      "audioAsset": "audio/barks/deacon-core/deacon-hit-amen",
      "audioStatus": "live"
    },
    {
      "id": "deacon-traffic-maker",
      "trigger": "takedown-into-traffic",
      "priority": 1,
      "text": "Go meet your maker. He drives a truck.",
      "audioAsset": "audio/barks/deacon-core/deacon-traffic-maker",
      "audioStatus": "live"
    },
    {
      "id": "deacon-traffic-works",
      "trigger": "takedown-into-traffic",
      "priority": 1,
      "text": "The Lord works in oncoming traffic.",
      "audioAsset": "audio/barks/deacon-core/deacon-traffic-works",
      "audioStatus": "live"
    },
    {
      "id": "deacon-down-test",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "A test of faith. You failed it.",
      "audioAsset": "audio/barks/deacon-core/deacon-down-test",
      "audioStatus": "live"
    },
    {
      "id": "deacon-down-forgive",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Forgive them. Then run them over.",
      "audioAsset": "audio/barks/deacon-core/deacon-down-forgive",
      "audioStatus": "live"
    },
    {
      "id": "deacon-down-again",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Again? I am praying for your brakes.",
      "audioAsset": "audio/barks/deacon-core/deacon-down-again",
      "audioStatus": "live"
    },
    {
      "id": "deacon-crash-soft",
      "trigger": "crash-self",
      "text": "The ditch was soft. Praise be.",
      "audioAsset": "audio/barks/deacon-core/deacon-crash-soft",
      "audioStatus": "live"
    },
    {
      "id": "deacon-crash-humbling",
      "trigger": "crash-self",
      "text": "A humbling. I needed that, apparently.",
      "audioAsset": "audio/barks/deacon-core/deacon-crash-humbling",
      "audioStatus": "live"
    },
    {
      "id": "deacon-near-sea",
      "trigger": "near-miss",
      "text": "Parted it like the Red Sea.",
      "audioAsset": "audio/barks/deacon-core/deacon-near-sea",
      "audioStatus": "live"
    },
    {
      "id": "deacon-near-angel",
      "trigger": "near-miss",
      "text": "Guardian angel's on overtime.",
      "audioAsset": "audio/barks/deacon-core/deacon-near-angel",
      "audioStatus": "live"
    },
    {
      "id": "deacon-lead-first",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "eq",
          "value": 1
        }
      ],
      "text": "The first shall be first. Ask anyone.",
      "audioAsset": "audio/barks/deacon-core/deacon-lead-first",
      "audioStatus": "live"
    },
    {
      "id": "deacon-late-home",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Nearly home. Not you, though.",
      "audioAsset": "audio/barks/deacon-core/deacon-late-home",
      "audioStatus": "live"
    },
    {
      "id": "deacon-hit-chad",
      "trigger": "hit-landed",
      "target": "chad-speedwell",
      "priority": 1,
      "text": "Repent, Chad. Then log off.",
      "audioAsset": "audio/barks/deacon-core/deacon-hit-chad",
      "audioStatus": "live"
    },
    {
      "id": "deacon-hit-rites",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Last rites are short. Like you.",
      "audioAsset": "audio/barks/deacon-core/deacon-hit-rites",
      "audioStatus": "live",
      "audioNote": "Redone 2026-10-02 (run W-S): both Whisper checks misheard the old take (\"Lass rites are short, like you.\"). Now Kokoro-82M, run locally, in Deacon Vane's reference voice (am_onyx, speed 0.85, pitch -1). Veto it, or ask for the old take back from git history."
    },
    {
      "id": "deacon-hit-forgave",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "I forgave you. My fist did not.",
      "audioAsset": "audio/barks/deacon-core/deacon-hit-forgave",
      "audioStatus": "live"
    },
    {
      "id": "deacon-near-notyet",
      "trigger": "near-miss",
      "when": [
        {
          "fact": "speaker.healthFrac",
          "op": "lt",
          "value": 0.4
        }
      ],
      "text": "Not yet, Lord. Not on this bike.",
      "audioAsset": "audio/barks/deacon-core/deacon-near-notyet",
      "audioStatus": "live"
    },
    {
      "id": "deacon-start-evening",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Evening service. Collection is mandatory.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-evening",
      "audioStatus": "live"
    },
    {
      "id": "deacon-start-sunrise",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "dawn"
        }
      ],
      "text": "Sunrise service. Bring your own ditch.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-sunrise",
      "audioStatus": "live"
    },
    {
      "id": "deacon-crash-pilgrim",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "gte",
          "value": 5
        }
      ],
      "text": "Last place is a pilgrimage too.",
      "audioAsset": "audio/barks/deacon-core/deacon-crash-pilgrim",
      "audioStatus": "live"
    },
    {
      "id": "deacon-down-chad",
      "trigger": "knocked-down-by-target",
      "target": "chad-speedwell",
      "priority": 1,
      "text": "Struck down by a ring light.",
      "audioAsset": "audio/barks/deacon-core/deacon-down-chad",
      "audioStatus": "live",
      "audioNote": "Redone 2026-10-02 (run W-S): the words were right, but the old take sounded least like Deacon Vane's other lines (speaker check). Now Kokoro-82M, run locally, in Deacon Vane's reference voice (am_onyx, speed 0.901, pitch -1). Veto it, or ask for the old take back from git history."
    },
    {
      "id": "deacon-traffic-vengeance",
      "trigger": "takedown-into-traffic",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "Vengeance is mine. And the truck's.",
      "audioAsset": "audio/barks/deacon-core/deacon-traffic-vengeance",
      "audioStatus": "live"
    },
    {
      "id": "deacon-start-keys-conch",
      "trigger": "race-start",
      "when": [
        {
          "fact": "region.id",
          "op": "eq",
          "value": "florida-keys"
        }
      ],
      "status": "live",
      "text": "Even the Conch Republic needs saving.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-keys-conch",
      "audioStatus": "live"
    },
    {
      "id": "deacon-start-pnw-flood",
      "trigger": "race-start",
      "when": [
        {
          "fact": "region.id",
          "op": "eq",
          "value": "pacific-northwest"
        }
      ],
      "status": "live",
      "text": "Forty days of rain. I've read this one.",
      "audioAsset": "audio/barks/deacon-core/deacon-start-pnw-flood",
      "audioStatus": "live"
    },
    {
      "id": "deacon-heckle-1",
      "trigger": "knocked-down-target",
      "text": "Rest here, sinner. The road won't."
    },
    {
      "id": "deacon-heckle-2",
      "trigger": "knocked-down-target",
      "text": "Pray on it. From the gravel."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "deacon-start-ditch is the approved line from the tone guide; every other line is an agent draft that stays until vetoed. M4 rivals-1 (built early) added conditioned lines: race state (leading, the last fifth, a hurt speaker or target, the back of the field), time of day, memory (a grudge held this race), and lines aimed at the rider's authored rivals. W-Q (2026-10-02) added two heckles (trigger knocked-down-target: said riding past a rider who is down), text only until the next voice batch.",
