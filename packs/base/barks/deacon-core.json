{
  "type": "bark-set",
  "id": "deacon-core",
  "name": "Deacon Vane: core lines",
  "tags": ["rival", "m1", "m2", "m4"],
  "defaults": {
    "speaker": "deacon-vane",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "deacon-start-ditch",
      "trigger": "race-start",
      "text": "Pray the ditch is soft, sinner."
    },
    {
      "id": "deacon-start-tithe",
      "trigger": "race-start",
      "text": "Tithe is ten percent. Of your bike."
    },
    {
      "id": "deacon-pass-behind",
      "trigger": "overtake",
      "text": "Get thee behind me. Stay there."
    },
    {
      "id": "deacon-pass-meek",
      "trigger": "overtake",
      "text": "The meek inherit the earth. Not this road."
    },
    {
      "id": "deacon-hit-baptized",
      "trigger": "hit-landed",
      "text": "Consider yourself baptized."
    },
    {
      "id": "deacon-hit-amen",
      "trigger": "hit-landed",
      "text": "Say amen. Say it from the ditch."
    },
    {
      "id": "deacon-traffic-maker",
      "trigger": "takedown-into-traffic",
      "priority": 1,
      "text": "Go meet your maker. He drives a truck."
    },
    {
      "id": "deacon-traffic-works",
      "trigger": "takedown-into-traffic",
      "priority": 1,
      "text": "The Lord works in oncoming traffic."
    },
    {
      "id": "deacon-down-test",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "A test of faith. You failed it."
    },
    {
      "id": "deacon-down-forgive",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Forgive them. Then run them over."
    },
    {
      "id": "deacon-down-again",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Again? I am praying for your brakes."
    },
    {
      "id": "deacon-crash-soft",
      "trigger": "crash-self",
      "text": "The ditch was soft. Praise be."
    },
    {
      "id": "deacon-crash-humbling",
      "trigger": "crash-self",
      "text": "A humbling. I needed that, apparently."
    },
    {
      "id": "deacon-near-sea",
      "trigger": "near-miss",
      "text": "Parted it like the Red Sea."
    },
    {
      "id": "deacon-near-angel",
      "trigger": "near-miss",
      "text": "Guardian angel's on overtime."
    },
    {
      "id": "deacon-lead-first",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "eq",
          "value": 1
        }
      ],
      "text": "The first shall be first. Ask anyone."
    },
    {
      "id": "deacon-late-home",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Nearly home. Not you, though."
    },
    {
      "id": "deacon-hit-chad",
      "trigger": "hit-landed",
      "target": "chad-speedwell",
      "priority": 1,
      "text": "Repent, Chad. Then log off."
    },
    {
      "id": "deacon-hit-rites",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Last rites are short. Like you."
    },
    {
      "id": "deacon-hit-forgave",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "I forgave you. My fist did not."
    },
    {
      "id": "deacon-near-notyet",
      "trigger": "near-miss",
      "when": [
        {
          "fact": "speaker.healthFrac",
          "op": "lt",
          "value": 0.4
        }
      ],
      "text": "Not yet, Lord. Not on this bike."
    },
    {
      "id": "deacon-start-evening",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Evening service. Collection is mandatory."
    },
    {
      "id": "deacon-start-sunrise",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "dawn"
        }
      ],
      "text": "Sunrise service. Bring your own ditch."
    },
    {
      "id": "deacon-crash-pilgrim",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "gte",
          "value": 5
        }
      ],
      "text": "Last place is a pilgrimage too."
    },
    {
      "id": "deacon-down-chad",
      "trigger": "knocked-down-by-target",
      "target": "chad-speedwell",
      "priority": 1,
      "text": "Struck down by a ring light."
    },
    {
      "id": "deacon-traffic-vengeance",
      "trigger": "takedown-into-traffic",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "Vengeance is mine. And the truck's."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "deacon-start-ditch is the approved line from the tone guide; every other line is an agent draft that stays until vetoed. M4 rivals-1 (built early) added conditioned lines: race state (leading, the last fifth, a hurt speaker or target, the back of the field), time of day, memory (a grudge held this race), and lines aimed at the rider's authored rivals.",
    "provenance": {
      "origin": "agent",
      "author": "agent",
      "createdAt": "2026-09-29"
    }
  }
}
