{
  "type": "bark-set",
  "id": "mother-rust-core",
  "name": "Mother Rust: core lines",
  "tags": ["rival", "m4"],
  "defaults": {
    "speaker": "mother-rust",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "rust-start-tires",
      "trigger": "race-start",
      "text": "I've eaten tires tougher than you.",
      "audioAsset": "audio/barks/mother-rust-core/rust-start-tires",
      "audioStatus": "live"
    },
    {
      "id": "rust-start-guest",
      "trigger": "race-start",
      "text": "Boys. We have a guest.",
      "audioAsset": "audio/barks/mother-rust-core/rust-start-guest",
      "audioStatus": "live"
    },
    {
      "id": "rust-pass-follow",
      "trigger": "overtake",
      "text": "Swamp's this way. Follow me in.",
      "audioAsset": "audio/barks/mother-rust-core/rust-pass-follow",
      "audioStatus": "live"
    },
    {
      "id": "rust-pass-water",
      "trigger": "overtake",
      "text": "Out of my water, city.",
      "audioAsset": "audio/barks/mother-rust-core/rust-pass-water",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-takes",
      "trigger": "hit-landed",
      "text": "The swamp takes what it wants.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-takes",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-knees",
      "trigger": "hit-landed",
      "text": "Today it wants your knees.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-knees",
      "audioStatus": "live"
    },
    {
      "id": "rust-traffic-feed",
      "trigger": "takedown-into-traffic",
      "text": "Feed it to the road, boys.",
      "audioAsset": "audio/barks/mother-rust-core/rust-traffic-feed",
      "audioStatus": "live"
    },
    {
      "id": "rust-traffic-gator",
      "trigger": "takedown-into-traffic",
      "text": "Gator food. Truck-sized gator.",
      "audioAsset": "audio/barks/mother-rust-core/rust-traffic-gator",
      "audioStatus": "live"
    },
    {
      "id": "rust-down-remembers",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "…The swamp remembers.",
      "audioAsset": "audio/barks/mother-rust-core/rust-down-remembers",
      "audioStatus": "live"
    },
    {
      "id": "rust-down-kin",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Kin will hear about this.",
      "audioAsset": "audio/barks/mother-rust-core/rust-down-kin",
      "audioStatus": "live"
    },
    {
      "id": "rust-crash-mud",
      "trigger": "crash-self",
      "text": "Mud's softer than it looks.",
      "audioAsset": "audio/barks/mother-rust-core/rust-crash-mud",
      "audioStatus": "live"
    },
    {
      "id": "rust-crash-moody",
      "trigger": "crash-self",
      "text": "Swamp threw me. Swamp's moody.",
      "audioAsset": "audio/barks/mother-rust-core/rust-crash-moody",
      "audioStatus": "live"
    },
    {
      "id": "rust-near-most",
      "trigger": "near-miss",
      "text": "Missed me. Most things do.",
      "audioAsset": "audio/barks/mother-rust-core/rust-near-most",
      "audioStatus": "live"
    },
    {
      "id": "rust-near-fishfry",
      "trigger": "near-miss",
      "text": "Dodged worse at a fish fry.",
      "audioAsset": "audio/barks/mother-rust-core/rust-near-fishfry",
      "audioStatus": "live"
    },
    {
      "id": "rust-lead-family",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "eq",
          "value": 1
        }
      ],
      "text": "Front of the family. Always.",
      "audioAsset": "audio/barks/mother-rust-core/rust-lead-family",
      "audioStatus": "live"
    },
    {
      "id": "rust-late-hungry",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Nearly home. The swamp's hungry.",
      "audioAsset": "audio/barks/mother-rust-core/rust-late-hungry",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-patient",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Lie down. The swamp is patient.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-patient",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-boys",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "My boys still talk about you.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-boys",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-mayor",
      "trigger": "hit-landed",
      "target": "the-mayor",
      "priority": 1,
      "text": "Your sign's on my land, Mayor.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-mayor",
      "audioStatus": "live"
    },
    {
      "id": "rust-hit-deacon",
      "trigger": "hit-landed",
      "target": "deacon-vane",
      "priority": 1,
      "text": "Preach to the gators, Deacon.",
      "audioAsset": "audio/barks/mother-rust-core/rust-hit-deacon",
      "audioStatus": "live"
    },
    {
      "id": "rust-down-count",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Twice now. The swamp keeps count.",
      "audioAsset": "audio/barks/mother-rust-core/rust-down-count",
      "audioStatus": "live"
    },
    {
      "id": "rust-near-ready",
      "trigger": "near-miss",
      "when": [
        {
          "fact": "speaker.healthFrac",
          "op": "lt",
          "value": 0.4
        }
      ],
      "text": "Not today. The swamp ain't ready.",
      "audioAsset": "audio/barks/mother-rust-core/rust-near-ready",
      "audioStatus": "live"
    },
    {
      "id": "rust-start-night",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Night's when the swamp eats.",
      "audioAsset": "audio/barks/mother-rust-core/rust-start-night",
      "audioStatus": "live"
    },
    {
      "id": "rust-crash-stragglers",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "gte",
          "value": 5
        }
      ],
      "text": "Back with the stragglers. Fine.",
      "audioAsset": "audio/barks/mother-rust-core/rust-crash-stragglers",
      "audioStatus": "live"
    },
    {
      "id": "rust-traffic-debts",
      "trigger": "takedown-into-traffic",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "Family settles debts. Slowly.",
      "audioAsset": "audio/barks/mother-rust-core/rust-traffic-debts",
      "audioStatus": "live"
    },
    {
      "id": "mother-rust-heckle-1",
      "trigger": "knocked-down-target",
      "text": "Ground's soft here. Stay a while."
    },
    {
      "id": "mother-rust-heckle-2",
      "trigger": "knocked-down-target",
      "text": "Gators eat at dusk, city."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "rust-start-tires is the approved line from the tone guide, verbatim; every other line is an agent draft (M4 rivals-1, built early) that stays until vetoed. Conditioned lines cover leading, the last fifth of the race, a hurt speaker or target, the back of the field, time of day, memory (a grudge held this race, repeat takedowns) and the speaker's authored rivals. W-Q (2026-10-02) added two heckles (trigger knocked-down-target: said riding past a rider who is down), text only until the next voice batch.",
    "provenance": {
      "origin": "agent",
      "author": "agent",
      "createdAt": "2026-10-01"
    },
    "voice": {
      "origin": "ai-batch",
      "batchId": "voices-wo-1",
      "model": "ResembleAI/chatterbox (MIT), via fal on Hugging Face Inference Providers",
      "reference": "hexgrad/Kokoro-82M (Apache-2.0) voice af_kore, speed 0.85, pitch -2 semitones; synthetic, no real person's voice",
      "promptRef": "tools/voices/cast.json",
      "generatedAt": "2026-10-01",
      "review": {
        "at": "2026-10-02",
        "by": "run W-S, voices lane",
        "method": "Every clip transcribed on the dev machine's GPU by Whisper large-v3-turbo and large-v3, plus pitch, pace, level and a speaker-similarity check (WavLM) against the rival's other clips (tools/voices/scripts/check_local.py). Garbled (both checks heard other words) or off-voice clips were redone free with Kokoro-82M on the GPU in the rival's reference voice (tools/voices/scripts/redo_local.py); everything else was kept.",
        "kept": 25,
        "redone": [],
        "cut": []
      }
    }
  }
}
