{
  "type": "bark-set",
  "id": "mother-rust-core",
  "name": "Mother Rust: core lines",
  "tags": ["rival", "m4"],
  "defaults": {
    "speaker": "mother-rust",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "rust-start-tires",
      "trigger": "race-start",
      "text": "I've eaten tires tougher than you."
    },
    {
      "id": "rust-start-guest",
      "trigger": "race-start",
      "text": "Boys. We have a guest."
    },
    {
      "id": "rust-pass-follow",
      "trigger": "overtake",
      "text": "Swamp's this way. Follow me in."
    },
    {
      "id": "rust-pass-water",
      "trigger": "overtake",
      "text": "Out of my water, city."
    },
    {
      "id": "rust-hit-takes",
      "trigger": "hit-landed",
      "text": "The swamp takes what it wants."
    },
    {
      "id": "rust-hit-knees",
      "trigger": "hit-landed",
      "text": "Today it wants your knees."
    },
    {
      "id": "rust-traffic-feed",
      "trigger": "takedown-into-traffic",
      "text": "Feed it to the road, boys."
    },
    {
      "id": "rust-traffic-gator",
      "trigger": "takedown-into-traffic",
      "text": "Gator food. Truck-sized gator."
    },
    {
      "id": "rust-down-remembers",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "…The swamp remembers."
    },
    {
      "id": "rust-down-kin",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "Kin will hear about this."
    },
    {
      "id": "rust-crash-mud",
      "trigger": "crash-self",
      "text": "Mud's softer than it looks."
    },
    {
      "id": "rust-crash-moody",
      "trigger": "crash-self",
      "text": "Swamp threw me. Swamp's moody."
    },
    {
      "id": "rust-near-most",
      "trigger": "near-miss",
      "text": "Missed me. Most things do."
    },
    {
      "id": "rust-near-fishfry",
      "trigger": "near-miss",
      "text": "Dodged worse at a fish fry."
    },
    {
      "id": "rust-lead-family",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "eq",
          "value": 1
        }
      ],
      "text": "Front of the family. Always."
    },
    {
      "id": "rust-late-hungry",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Nearly home. The swamp's hungry."
    },
    {
      "id": "rust-hit-patient",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "Lie down. The swamp is patient."
    },
    {
      "id": "rust-hit-boys",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "My boys still talk about you."
    },
    {
      "id": "rust-hit-mayor",
      "trigger": "hit-landed",
      "target": "the-mayor",
      "priority": 1,
      "text": "Your sign's on my land, Mayor."
    },
    {
      "id": "rust-hit-deacon",
      "trigger": "hit-landed",
      "target": "deacon-vane",
      "priority": 1,
      "text": "Preach to the gators, Deacon."
    },
    {
      "id": "rust-down-count",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Twice now. The swamp keeps count."
    },
    {
      "id": "rust-near-ready",
      "trigger": "near-miss",
      "when": [
        {
          "fact": "speaker.healthFrac",
          "op": "lt",
          "value": 0.4
        }
      ],
      "text": "Not today. The swamp ain't ready."
    },
    {
      "id": "rust-start-night",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Night's when the swamp eats."
    },
    {
      "id": "rust-crash-stragglers",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "gte",
          "value": 5
        }
      ],
      "text": "Back with the stragglers. Fine."
    },
    {
      "id": "rust-traffic-debts",
      "trigger": "takedown-into-traffic",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "Family settles debts. Slowly."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "rust-start-tires is the approved line from the tone guide, verbatim; every other line is an agent draft (M4 rivals-1, built early) that stays until vetoed. Conditioned lines cover leading, the last fifth of the race, a hurt speaker or target, the back of the field, time of day, memory (a grudge held this race, repeat takedowns) and the speaker's authored rivals.",
    "provenance": {
      "origin": "agent",
      "author": "agent",
      "createdAt": "2026-10-01"
    }
  }
}
