{
  "type": "bark-set",
  "id": "mayor-core",
  "name": "The Mayor: core lines",
  "tags": ["rival", "m4"],
  "defaults": {
    "speaker": "the-mayor",
    "cooldownS": 90,
    "weight": 1
  },
  "lines": [
    {
      "id": "mayor-start-vote",
      "trigger": "race-start",
      "text": "Vote early. Crash often."
    },
    {
      "id": "mayor-start-bridge",
      "trigger": "race-start",
      "text": "This bridge was my idea. So is this."
    },
    {
      "id": "mayor-pass-pardon",
      "trigger": "overtake",
      "text": "Pardon me. Officially."
    },
    {
      "id": "mayor-pass-motorcade",
      "trigger": "overtake",
      "text": "Make way for the motorcade. It's me."
    },
    {
      "id": "mayor-hit-ditch",
      "trigger": "hit-landed",
      "text": "My opponent is lying. In a ditch."
    },
    {
      "id": "mayor-hit-veto",
      "trigger": "hit-landed",
      "text": "That's a line-item veto."
    },
    {
      "id": "mayor-traffic-calming",
      "trigger": "takedown-into-traffic",
      "text": "Traffic calming. Funded by you."
    },
    {
      "id": "mayor-traffic-ribbon",
      "trigger": "takedown-into-traffic",
      "text": "Ribbon cutting. Effective now."
    },
    {
      "id": "mayor-down-comment",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "No comment. NO COMMENT."
    },
    {
      "id": "mayor-down-recount",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "text": "I'll be calling for a recount."
    },
    {
      "id": "mayor-crash-council",
      "trigger": "crash-self",
      "text": "Pothole. I blame the council."
    },
    {
      "id": "mayor-crash-photo",
      "trigger": "crash-self",
      "text": "Photo op. Ruined."
    },
    {
      "id": "mayor-near-race",
      "trigger": "near-miss",
      "text": "Close race. Like my last one."
    },
    {
      "id": "mayor-near-subpoena",
      "trigger": "near-miss",
      "text": "Dodged it like a subpoena."
    },
    {
      "id": "mayor-lead-polls",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "eq",
          "value": 1
        }
      ],
      "text": "Leading in the polls. And the road."
    },
    {
      "id": "mayor-late-term",
      "trigger": "overtake",
      "when": [
        {
          "fact": "race.progress",
          "op": "gte",
          "value": 0.8
        }
      ],
      "text": "Final stretch. Like my second term."
    },
    {
      "id": "mayor-hit-kevin",
      "trigger": "hit-landed",
      "target": "kevin-from-accounting",
      "priority": 1,
      "text": "Your invoice is in the mail, Kevin."
    },
    {
      "id": "mayor-hit-guilty",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "target.healthFrac",
          "op": "lt",
          "value": 0.3
        }
      ],
      "text": "My office has found you guilty."
    },
    {
      "id": "mayor-hit-grudge",
      "trigger": "hit-landed",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "My office has reviewed the incident."
    },
    {
      "id": "mayor-down-kevin",
      "trigger": "knocked-down-by-target",
      "target": "kevin-from-accounting",
      "priority": 1,
      "text": "Accounting has gone rogue."
    },
    {
      "id": "mayor-down-again",
      "trigger": "knocked-down-by-target",
      "target": "player",
      "priority": 1,
      "when": [
        {
          "fact": "history.takedowns.targetOnSpeaker",
          "op": "gte",
          "value": 2
        }
      ],
      "text": "Again? I'm declaring an emergency."
    },
    {
      "id": "mayor-near-recess",
      "trigger": "near-miss",
      "when": [
        {
          "fact": "speaker.healthFrac",
          "op": "lt",
          "value": 0.4
        }
      ],
      "text": "Fleeing? This is a tactical recess."
    },
    {
      "id": "mayor-start-late",
      "trigger": "race-start",
      "when": [
        {
          "fact": "timeOfDay",
          "op": "eq",
          "value": "night"
        }
      ],
      "text": "Late session. Nobody's watching."
    },
    {
      "id": "mayor-crash-tour",
      "trigger": "crash-self",
      "when": [
        {
          "fact": "race.position.speaker",
          "op": "gte",
          "value": 5
        }
      ],
      "text": "Call this a listening tour."
    },
    {
      "id": "mayor-traffic-addressed",
      "trigger": "takedown-into-traffic",
      "when": [
        {
          "fact": "grudge.speakerTowardTarget",
          "op": "gte",
          "value": 1
        }
      ],
      "text": "Consider your grievance addressed."
    }
  ],
  "meta": {
    "status": "live",
    "notes": "mayor-start-vote is the approved line from the tone guide, verbatim; every other line is an agent draft (M4 rivals-1, built early) that stays until vetoed. Conditioned lines cover leading, the last fifth of the race, a hurt speaker or target, the back of the field, time of day, memory (a grudge held this race, repeat takedowns) and the speaker's authored rivals.",
    "provenance": {
      "origin": "agent",
      "author": "agent",
      "createdAt": "2026-10-01"
    }
  }
}
