# Working space and private notes (never committed)
scratch/
*.local.md
local/
.cache/

# Agent working state and logs (local permissions and worktrees stay ignored;
# only the generic run template .claude/workflows/lane-run.js is committed; other saved
# workflow scripts carry local paths and stay ignored)
.claude/*
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/lane-run.js
*.log

# Build output and dependencies
node_modules/
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/

# Environment files
.env*
