# Working space and private notes (never committed)
scratch/
*.local.md
local/
.cache/

# Agent working state and logs (local permissions and worktrees stay ignored;
# only the saved run template in .claude/workflows/ is committed)
.claude/*
!.claude/workflows/
*.log

# Build output and dependencies
node_modules/
dist/
*.tsbuildinfo

# Test output
test-results/
playwright-report/

# Environment files
.env*
